# Copy to .env on the VM. Never commit .env.
# Workers are headless Claude Code pointed at OpenRouter's Anthropic-compatible endpoint.
OPENROUTER_API_KEY=sk-or-v1-...            # https://openrouter.ai/settings/keys (set a credit limit on the key)
ANTHROPIC_BASE_URL=https://openrouter.ai/api
P2O_PROVIDER=openrouter
# Candidates (pilot both on the 3 dev tasks in M4, then freeze ONE for every config):
#   z-ai/glm-5.3-flash            deepseek/deepseek-v4.1-flash
# Use exact slugs only: no "~...-latest" aliases (they float) and no ":batch" variants.
# The model must have an entry in prices_per_mtok in configs/*.yaml, or config loading fails.
P2O_MODEL=z-ai/glm-5.3-flash               # FROZEN 2026-11-06 (PROGRESS M0)
P2O_TOKEN_CAP=20000000                     # FROZEN: ~$0.75 at observed cached-heavy mix; in-session USD cap = caps.max_usd
P2O_BUDGET_USD=150
HF_TOKEN=hf_...                            # for the gated CyberGym-E2E dataset
