# Copy to .env and fill in the two secrets. Never commit .env.
# Workers are headless Claude Code sessions pointed at OpenRouter's Anthropic-compatible endpoint.
OPENROUTER_API_KEY=sk-or-v1-...            # https://openrouter.ai/settings/keys (set a credit limit on the key)
HF_TOKEN=hf_...                            # for the gated CyberGym-E2E dataset

# Values used for every reported run (configs/*.yaml default to the same values).
ANTHROPIC_BASE_URL=https://openrouter.ai/api
P2O_PROVIDER=openrouter
P2O_MODEL=z-ai/glm-5.3-flash               # exact slug; must be a key of prices_per_mtok in configs/*.yaml
P2O_TOKEN_CAP=20000000                     # per-run token cap; the per-run USD cap is caps.max_usd ($0.75)
P2O_BUDGET_USD=150                         # global spend cap across all runs (p2o.cli budget)
